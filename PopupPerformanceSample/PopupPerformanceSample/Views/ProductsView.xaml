<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:SfListView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="PopupPerformanceSample.ProductDetailsPopupView"
             Padding="10,0,10,10">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Label x:Name="ProductPrice"
               FontSize="18"
               TextColor="Green"
               Grid.Row="0"/>
        <SfListView:SfListView x:Name="VariantsList"
                               Grid.Row="1"
                               ItemsSource="{Binding Variants}"
                               SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"
                               SelectionMode="Single"
                               AutoFitMode="Height"
                               ItemSize="72"
                               SelectionBackground="LightBlue"
                              >
            <SfListView:SfListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="60,*,Auto"
                          RowDefinitions="Auto,0.5"
                          RowSpacing="3"
                          HeightRequest="70"
                          ColumnSpacing="10"
                          Padding="10">
                        <Image Grid.Row="0" Grid.Column="0"
                               Source="{Binding Image}"
                               WidthRequest="56"
                               HeightRequest="56"
                               Aspect="AspectFit"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Specs}" FontSize="12" TextColor="#6B7280" />
                        </VerticalStackLayout>
                        <Label Grid.Row="0" Grid.Column="2"
                               Text="{Binding Price, StringFormat='{}{0:C}'}"
                               TextColor="#2E7D32"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
                               HorizontalTextAlignment="End" />
                        <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                 HeightRequest="0.5"
                                 Color="Gray" />
                    </Grid>
                </DataTemplate>
            </SfListView:SfListView.ItemTemplate>
        </SfListView:SfListView>

        <buttons:SfButton x:Name="AddToCartButton"
                          Grid.Row="2"
                          HeightRequest="44"
                          CornerRadius="10"
                          Text="Add to Cart"
                          TextColor="White"
                          IsEnabled="{Binding HasSelectedVariant}"
                          Clicked="OnAddToCartClicked">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="#0078D7" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="#0A66C2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Hovered">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="#1E88E5" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="#9CA3AF" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </buttons:SfButton>
    </Grid>
</ContentView>
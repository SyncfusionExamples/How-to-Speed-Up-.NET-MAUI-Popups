<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sflistview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             x:Class="PopupPerformanceSample.Views.ProductDetailsPopupView"
             Padding="10,0,10,10">
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="10">
        <Label x:Name="ProductName"
               FontSize="20"
               FontAttributes="Bold"
               Grid.Row="0" />
        <Label x:Name="ProductPrice"
               FontSize="18"
               TextColor="Green"
               Grid.Row="1" />
        <CollectionView x:Name="VariantsList"
                               Grid.Row="2"
                               SelectionMode="Single"
                              SelectionChanged="VariantsList_SelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#cccccc"
                            StrokeThickness="1"
                            Padding="10"
                            Margin="5"
                            BackgroundColor="#f0f0f0"
                            StrokeShape="RoundRectangle 8">
                        <Label Text="{Binding}"
                               Padding="5"
                               FontSize="16" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal"></VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor"
                                                Value="LightBlue"></Setter>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Add to Cart"
                BackgroundColor="#0078D7"
                TextColor="White"
                Clicked="OnAddToCartClicked"
                Grid.Row="3"
                HeightRequest="40"
                CornerRadius="8" />
    </Grid>
</ContentView>
